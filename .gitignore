# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (every .env file except the blank template)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase Admin service account keys (never commit)
*-firebase-adminsdk-*.json

# Firebase emulator data and logs
.emulator-data/
*-debug.log

.vercel

# Design mockups shown in the Claude desktop browser pane
.mockups/

# Snapshots and logs from the playwright Claude Code plugin
.playwright-mcp/

# Playwright test results and report
/test-results/
/playwright-report/

# Cloudflare's security-audit skill, installed locally for release audits
# (`npx skills add`), and its lock file. Reports go to ~/security-audit-skill/.
.agents/
.claude/skills/
skills-lock.json

# Impeccable critique reports (ignore.md is shared)
.impeccable/critique/*.md
!.impeccable/critique/ignore.md
