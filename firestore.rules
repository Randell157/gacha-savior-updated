rules_version = '2';

// Source of truth for the project's Firestore rules. Test changes against the
// emulator (`npm run emulators`), then deploy with
// `npx firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Profile ({ username, email, createdAt }) and everything stored under
    // it, such as users/{uid}/games/genshin and its artifact chunks.
    // avatarImage, the uploaded picture, is a small JPEG data URL; it lives here
    // because Cloud Storage needs a paid plan. The browser crops it to 256 px.
    function validPicture(data) {
      return !('avatarImage' in data)
             || data.avatarImage == null
             || (data.avatarImage is string
                 && data.avatarImage.size() <= 200000
                 && data.avatarImage.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'));
    }

    // The profile itself can't be deleted from the browser (the delete-account
    // route does it): a deleted and re-created profile would let the account
    // claim another username below.
    // deletedAccounts/{uid} is written by the delete-account route before it
    // deletes anything. Its token stays valid for up to an hour, so without
    // this check the browser could recreate the profile mid-delete and leave a
    // username claimed by an account that's gone.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validPicture(request.resource.data)
                    && !exists(/databases/$(database)/documents/deletedAccounts/$(userId));
      allow update: if isOwner(userId) && validPicture(request.resource.data);

      // {collection} first: on its own, {document=**} also matches users/{userId}
      // itself, which would let any profile write skip validPicture.
      match /{collection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // usernames/{lowercased name} -> { uid }. Claimed at sign-up. Logging in with
    // a username, password resets by username, changing a username and deleting
    // an account go through API routes that use the Admin SDK and aren't bound
    // by these rules.
    match /usernames/{username} {
      // One name at a time (sign-up checks whether it's free); no listing, so
      // nobody can download every username.
      allow get: if request.auth != null;
      // Only at sign-up: the profile doesn't exist yet and is created in the
      // same transaction with this name, so each account gets one claim.
      allow create: if request.auth != null
                    && username == username.lower()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(["uid"])
                    && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() == username;
      allow update, delete: if false;
    }
  }
}
