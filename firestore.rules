rules_version = '2';

// Source of truth for the project's Firestore rules. Test changes against the
// emulator (`npm run emulators`), then deploy with
// `npx firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Profile ({ username, email, createdAt }) and everything stored under
    // it, such as users/{uid}/games/genshin and its artifact chunks.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // usernames/{lowercased name} -> { uid }. Claimed once at sign-up, never
    // changed. Signed-out login lookups go through /api/auth/resolve-username,
    // which uses the Admin SDK and isn't bound by these rules.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && username == username.lower()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(["uid"]);
      allow update, delete: if false;
    }
  }
}
